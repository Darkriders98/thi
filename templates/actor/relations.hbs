<section class="standard-form tab scrollable {{tab.cssClass}}" data-group="primary" data-tab="relations">
  <fieldset>
    <legend>{{itemTypes.label}}</legend>
    <ul class="items">
      {{#if editable}}
        <li class="item-header">
          <a class="item-control item-create" title="{{localize 'DOCUMENT.Create' type=itemTypes.label}}"
            data-action="createDoc" data-document-class="Item" data-type="contact">
            <i class="fas fa-plus"></i>
            {{localize 'DOCUMENT.New' type=itemTypes.label}}
          </a>
        </li>
      {{/if}}
      <li class="item-header">
        <span class="affection">{{localize 'THI.Contact.FIELDS.affection.label'}}</span>
        <span class="arcana">{{localize 'THI.Contact.FIELDS.arcana.label'}}</span>
        <span class="description">{{localize 'THI.Contact.FIELDS.description.label'}}</span>
        <span class="distance">{{localize 'THI.Contact.FIELDS.distance.label'}}</span>
      </li>
      {{#each itemTypes.items as |item|}}
        {{#with system}}
          <li class="item flexrow draggable" data-item-id="{{item._id}}" data-document-class="Item">
            <img class="affection" width="80px" height="80px" data-fill="{{affection}}">
            <span class="name">{{../name}}</span>
            <span class="arcana">{{visionLabel arcana}}</span>
            <span class="description">{{description}}</span>
            <img class="distance" width="80px" height="80px" data-fill="{{distance}}">
            {{#if @root.editable}}
              <div class="document-controls">
                <a class="item-control item-edit" title="{{localize 'DOCUMENT.Update' type=item.name}}"
                  data-action="viewDoc">
                  <i class="{{localize 'ICONS.Edit'}}"></i>
                </a>
                <a class="item-control item-delete" title="{{localize 'DOCUMENT.Delete' type=item.name}}"
                  data-action="deleteDoc">
                  <i class="{{localize 'ICONS.Delete'}}"></i>
                </a>
              </div>
            {{/if}}
          </li>
        {{/with}}
      {{/each}}
    </ul>
  </fieldset>
</section>