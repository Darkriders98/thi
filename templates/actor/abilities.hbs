<section class="standard-form tab scrollable {{tab.cssClass}}" data-group="primary" data-tab="abilities">
  <div class="flexrow">
    {{#with field.fields.[0]}}
      {{> thi.field-xp max=field.max value=value}}
    {{/with}}
    <div class="guild">
      {{#if (eq class undefined)}}
        <h1>{{localize 'THI.Agent.FIELDS.abilities.guild.null'}}</h1>
      {{else}}
        <h1>{{localize 'THI.Agent.FIELDS.abilities.guild.exist' name=class.system.guild}}</h1>
      {{/if}}
    </div>
  </div>
  <ul class="itemTypes" data-tab="items">
    <li class="itemHeader flexrow">
      <div class="type-label">
        {{itemTypes.label}}
      </div>
      <div class="document-controls">
        {{#if editable}}
          <a class="item-control item-create" title="{{localize 'DOCUMENT.Create' type=itemTypes.label}}"
            data-action="createDoc" data-document-class="Item" data-type="ability">
            <i class="fas fa-plus"></i>
            {{localize 'DOCUMENT.New' type=itemTypes.label}}
          </a>
        {{/if}}
      </div>
    </li>
    <ul class="items">
      {{#each itemTypes.items as |item|}}
        <li class="item flexrow draggable" data-item-id="{{item._id}}" data-document-class="Item">
          <img src="{{item.img}}" alt="{{item.name}}" width="50" height="50">
          <div class="item-name">{{item.name}}</div>
          <div class="item-summary">{{item.system.summary}}</div>
          <div class="document-controls">
            <a class="item-control item-expand" title="{{localize 'DOCUMENT.Expand' type=item.name}}"
              data-action="expandDoc">
              <i class="{{localize 'ICONS.Description'}}"></i>
            </a>
            {{#if @root.editable}}
              <a class="item-control item-edit" title="{{localize 'DOCUMENT.Update' type=item.name}}" data-action="viewDoc">
                <i class="{{localize 'ICONS.Edit'}}"></i>
              </a>
              <a class="item-control item-delete" title="{{localize 'DOCUMENT.Delete' type=item.name}}"
                data-action="deleteDoc">
                <i class="{{localize 'ICONS.Delete'}}"></i>
              </a>
            {{/if}}
          </div>
        </li>
      {{/each}}
    </ul>
  </ul>

</section>