<header class="sheet-header flexrow">
  <img class="profile-img" src="{{actor.img}}" alt="{{actor.name}}" {{#if editable}} data-action="editImage" data-edit="img"
    {{/if}} data-tooltip="{{actor.name}}" height="100" width="100">
  <div class="fields">
    {{#if editable}}
      <input type="text" name="name" class="document-name uninput" value="{{actor._source.name}}">
    {{else}}
      <div class="document-name">{{actor.name}}</div>
    {{/if}}
  </div>
</header>