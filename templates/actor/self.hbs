<section class="standard-form tab scrollable {{tab.cssClass}}" data-group="primary" data-tab="self">
  <fieldset class="side-fieldset">
    <legend>{{localize 'THI.Self.Negative'}}</legend>
    {{log fields}}
    {{> thi.field-self-minor fields.negative.[0]}}
    {{> thi.field-self-major fields.negative.[1]}}
  </fieldset>
  <div>
    <fieldset>
      <legend>{{localize 'THI.Self.Core'}}</legend>
      {{#with fields.core.[1]}}
        <div>{{localize 'THI.Self.Childhood'}}</div>
        {{#if @root.editable}}
          {{formGroup field value=value}}
        {{else}}
          <div>{{value}}</div>
        {{/if}}
      {{/with}}
      {{#with fields.core.[0]}}
        <div>{{localize 'THI.Self.Adulthood'}}</div>
        {{#if @root.editable}}
          {{formGroup field value=value}}
        {{else}}
          <div>{{value}}</div>
        {{/if}}
      {{/with}}
    </fieldset>
    {{#with fields.core.[2]}}
      <fieldset data-field-path="{{field.fieldPath}}" class="array-field">
        <legend>
          {{field.label}}
          {{#if @root.editable}}
            <a data-action="removeArrayField">
              <i class="{{localize 'ICONS.Delete'}}"></i>
            </a>
          {{/if}}
        </legend>
        <ul>
          {{#each value}}
            <li>{{this}}</li>
          {{/each}}
        </ul>
      </fieldset>
    {{/with}}
  </div>
  <fieldset class="side-fieldset">
    <legend>{{localize 'THI.Self.Positive'}}</legend>
    {{> thi.field-self-minor fields.positive.[0]}}
    {{> thi.field-self-major fields.positive.[1] redirect=fields.core.[2]}}
  </fieldset>
</section>