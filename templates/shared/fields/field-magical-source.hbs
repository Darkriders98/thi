<legend>{{label}}</legend>
<ul class="items">
  {{#if @root.editable}}
    <li class="item-header">
      <a class="item-control item-create" title="{{localize 'DOCUMENT.Create' type=label}}" data-action="createDoc"
        data-document-class="Item" data-type="magicalsource">
        <i class="fas fa-plus"></i>
        {{localize 'DOCUMENT.New' type=label}}
      </a>
    </li>
  {{/if}}
  {{#each items as |item|}}
    <li class="item flexrow draggable" data-item-id="{{item._id}}" data-document-class="Item">
      <div class="item-name">{{item.name}}</div>
      <div class="document-controls">
        <a class="item-control item-expand" title="{{localize 'DOCUMENT.Expand' type=item.name}}" data-action="expandDoc">
          <i class="{{localize 'ICONS.Description'}}"></i>
        </a>
        {{#if @root.editable}}
          <a class="item-control item-edit" title="{{localize 'DOCUMENT.Update' type=item.name}}" data-action="viewDoc">
            <i class="{{localize 'ICONS.Edit'}}"></i>
          </a>
          <a class="item-control item-delete" title="{{localize 'DOCUMENT.Delete' type=item.name}}" data-action="deleteDoc">
            <i class="{{localize 'ICONS.Delete'}}"></i>
          </a>
        {{/if}}
      </div>
    </li>
  {{/each}}
</ul>